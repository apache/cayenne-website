<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item navbar-logo" href="{{{siteRootPath}}}/../">
        <img src="{{{siteRootPath}}}/../img/logo_mono_full.svg" alt="Apache Cayenne" height="32">
      </a>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <div class="search-control">
            <span class="search-icon" aria-hidden="true">
              <img src="{{{siteRootPath}}}/../img/search.svg" alt="" width="16" height="16">
            </span>
            <input id="search-input" type="text" placeholder="Search" aria-label="Search documentation" autocomplete="off"{{#if page.home}} autofocus{{/if}}>
          </div>
        </div>
      </div>
      {{/if}}
      <button class="navbar-burger" data-target="topbar-nav" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="{{{siteRootPath}}}/../download/">Download</a>
        <a class="navbar-item" href="{{{siteRootPath}}}/../about/support/">Support</a>
        <a class="navbar-item navbar-icon" href="https://github.com/apache/cayenne" title="GitHub" aria-label="GitHub">
          <img src="{{{siteRootPath}}}/../img/icon_github.svg" alt="" width="22" height="22">
        </a>
        <a class="navbar-item navbar-icon" href="https://twitter.com/ApacheCayenne" title="X" aria-label="X">
          <img src="{{{siteRootPath}}}/../img/icon_x.svg" alt="" width="18" height="18">
        </a>
      </div>
    </div>
  </nav>
</header>
