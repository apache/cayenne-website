<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apache.cayenne.site</groupId>
    <artifactId>cayenne-website</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>cayenne.apache.org website</name>
    <description>Sources for https://cayenne.apache.org website</description>

    <packaging>pom</packaging>

    <properties>
        <hugo.baseurl>https://cayenne.apache.org/</hugo.baseurl>
        <node.version>v24.18.0</node.version>
        <corepack.version>0.35.0</corepack.version>
        <dev.port>8080</dev.port>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>2.0.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-scm-publish-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>site/resources/_gen</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-node-and-corepack</id>
                        <goals>
                            <goal>install-node-and-corepack</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <corepackVersion>${corepack.version}</corepackVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn-install</id>
                        <goals>
                            <goal>corepack</goal>
                        </goals>
                        <configuration>
                            <arguments>yarn install --immutable</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>corepack</goal>
                        </goals>
                        <configuration>
                            <arguments>yarn run build</arguments>
                            <environmentVariables>
                                <HUGO_BASEURL>${hugo.baseurl}</HUGO_BASEURL>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>link-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>corepack</goal>
                        </goals>
                        <configuration>
                            <arguments>yarn run site:check</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
    Use `mvn clean package` to build the site.
    Use `mvn -Pdev-server` to build and serve the site locally.
    Use `mvn -Ppublish -Dmsg="commit message"` to build and publish the production version.
    -->
    <profiles>
        <profile>
            <id>dev-server</id>
            <properties>
                <hugo.baseurl>http://localhost:${dev.port}/</hugo.baseurl>
            </properties>
            <build>
                <defaultGoal>generate-resources frontend:corepack@site-docs frontend:corepack@site-dev</defaultGoal>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>site-docs</id>
                                <phase/>
                                <goals>
                                    <goal>corepack</goal>
                                </goals>
                                <configuration>
                                    <arguments>yarn run docs</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>site-dev</id>
                                <phase/>
                                <goals>
                                    <goal>corepack</goal>
                                </goals>
                                <configuration>
                                    <arguments>yarn run site:watch --port ${dev.port}</arguments>
                                    <environmentVariables>
                                        <HUGO_BASEURL>${hugo.baseurl}</HUGO_BASEURL>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>publish</id>
            <properties>
                <hugo.baseurl>https://m-dzianishchyts.github.io/cayenne-website/</hugo.baseurl>
            </properties>
            <build>
                <defaultGoal>clean package</defaultGoal>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-property</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>msg</property>
                                            <message>Please specify a commit message for publishing the website (-Dmsg="...")</message>
                                        </requireProperty>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-scm-publish-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <content>${project.build.directory}/site</content>
                            <checkoutDirectory>${project.basedir}/.scm-publish-checkout</checkoutDirectory>
                            <checkinComment>${msg}</checkinComment>
                            <pubScmUrl>scm:git:https://github.com/apache/cayenne-website.git</pubScmUrl>
                            <scmBranch>gh-pages</scmBranch>
                        </configuration>
                        <executions>
                            <execution>
                                <id>publish-site</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>publish-scm</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
