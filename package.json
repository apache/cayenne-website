{
  "name": "cayenne-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "description": "Apache Cayenne website",
  "scripts": {
    "build": "yarn run site && yarn run docs",
    "docs": "antora --log-failure-level error --log-level info --log-format pretty docs/antora-playbook.yml",
    "site": "hugo --source site --destination ../target/site",
    "site:watch": "hugo server --source site --destination ../target/site --disableFastRender"
  },
  "hugo-bin": {
    "buildTags": "extended",
    "version": "0.164.0"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "font-awesome": "4.7.0"
  },
  "devDependencies": {
    "@antora/collector-extension": "^1.0.3",
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "antora": "^3.1.15",
    "hugo-bin": "^0.149.2"
  }
}
